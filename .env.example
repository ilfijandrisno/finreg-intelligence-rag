# Application Environment
APP_NAME=finreg-intelligence
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=finreg_db
POSTGRES_USER=finreg_user
POSTGRES_PASSWORD=finreg_password

# Vector Database Configuration (Future Phases)
VECTOR_TABLE=chunk_embeddings
VECTOR_DIMENSION=1536
VECTOR_DISTANCE_METRIC=cosine

# LLM Provider Configuration (Future Phases)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=

# Embedding Provider Configuration (Future Phases)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=your-api-key-here
EMBEDDING_DIMENSION=1536
