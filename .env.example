# Application Environment
APP_NAME=finreg-intelligence
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=finreg_db
POSTGRES_USER=finreg_user
POSTGRES_PASSWORD=finreg_password

# Ingestion Engine Configuration
MAX_DISCOVERED_DOCUMENTS=50
REQUEST_DELAY_SECONDS=1.0
MAX_CONCURRENT_DOWNLOADS=2
DOWNLOAD_TIMEOUT_SECONDS=30.0
MAX_RETRIES=3
RAW_DATA_DIR=data/raw
METADATA_DATA_DIR=data/metadata
PARSING_MIN_COVERAGE_RATIO=0.90

# Vector Database Configuration (Future Phases)
VECTOR_TABLE=chunk_embeddings
VECTOR_DIMENSION=1536
VECTOR_DISTANCE_METRIC=cosine

# LLM Provider Configuration (Future Phases)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=

# Embedding Provider Configuration (Future Phases)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=your-api-key-here
EMBEDDING_DIMENSION=1536
